{
  "manifest_version": 3,
  "name": "Job Fit Overlay",
  "version": "1.0.0",
  "key": "",
  "description": "Automatic job fit scoring and qualification rubric overlay based on your credentials and standing rules.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Fit Scorer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.indeed.ie/*",
        "*://*.jobleads.com/*",
        "*://*.irishjobs.ie/*",
        "*://*.jobs.ie/*",
        "*://*.smartrecruiters.com/*",
        "*://*.bamboohr.com/*",
        "*://*.pinpointhq.com/*",
        "*://*.workable.com/*",
        "*://*.ashbyhq.com/*",
        "*://*.glassdoor.com/*",
        "*://*.glassdoor.ie/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.myworkdayjobs.com/*"
      ],
      "js": [
        "rules.js",
        "engine.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.css",
        "rules.json",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "job-fit-overlay@jobfit.local"
    }
  }
}
